# Copier ce fichier en .env sur le serveur, et remplir les valeurs réelles.
# Ne jamais mettre de secret dans le code, dans le chat, ni dans un dépôt public.
# Les secrets passent par la voie sécurisée, et sont stockés côté serveur uniquement.
PORT=3000
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/connexionprophetique
DATABASE_SSL=false
JWT_SECRET=au-moins-32-caracteres-a-generer-sur-le-serveur
CORS_ORIGINS=https://connexionprophetique.com,https://www.connexionprophetique.com
UPLOAD_DIR=./uploads
WAVE_PAYMENT_LINK=
WAVE_WEBHOOK_SECRET=
WAVE_ENFORCE_IP=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_API_BASE=
PUBLIC_BASE_URL=https://connexion-prophetique.onrender.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Notifications poussées Android, 2 nov. 2026 : JSON complet du
# compte de service Firebase, tel que téléchargé depuis la console
# Firebase, à saisir dans Render seulement, jamais dans ce fichier
# rempli, jamais dans le dépôt, jamais dans le chat. Sans cette
# variable, la cloche continue et la poussée est ignorée.
FIREBASE_SERVICE_ACCOUNT_JSON=
