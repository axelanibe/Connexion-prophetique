<?xml version="1.0" encoding="utf-8"?>
<!-- Carte 116, 9 nov. 2026, puis C-2, 22 nov. 2026 : les secrets
     de session (jetons api_access_token et api_refresh_token) vivent
     dans le coffre du système, fichier « FlutterSecureStorage »,
     exclu de la sauvegarde cloud comme du transfert d'appareil à
     appareil, comme « auth_cp » avant lui. Le reste des préférences
     (journal, taille du texte, réglages) reste sauvegardé : les
     données personnelles et les réglages partagent le même fichier
     de préférences, ils ne sont pas séparables sans casser les
     réglages, donc pas d'exclusion ici, c'est l'effacement à la
     déconnexion (H-2) qui les protège sur un appareil partagé.
     Règles pour Android 12 et plus (API 31 et plus). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_cp.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_cp.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
