<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de lancement natif, avant le logo animé Flutter.
     Fond bleu nuit, comme l'écran d'ouverture animé, pour que la
     transition soit continue, sans écran blanc ou noir avec une
     petite icône. Couleur définie dans values/colors.xml, car une
     couleur en dur dans android:drawable est rejetée par AAPT.
     Correctif 27 oct. 2026, d'après l'échec du build 39. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
</layer-list>
