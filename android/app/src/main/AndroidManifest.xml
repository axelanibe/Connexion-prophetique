<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Photos et médias, 29 oct. 2026 : demandés à l'écran de
         bienvenue du premier lancement. Ni mobile_scanner (qui
         déclare déjà CAMERA) ni gal ne les déclarent, et
         flutter_local_notifications déclare déjà POST_NOTIFICATIONS.
         Seules ces deux déclarations manquaient réellement. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Création de story, 17 nov. 2026 : la galerie de
         photo_manager liste aussi les vidéos, il faut la
         déclaration correspondante sur Android 13 et plus. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Carte 94, 8 nov. 2026 : socle des notifications programmées,
         voir la documentation de flutter_local_notifications 19.5.0.
         Sans ces deux permissions et sans les deux receveurs ci
         dessous, une notification programmée ne peut jamais être
         délivrée par Android, même permission accordée et heure
         juste. SCHEDULE_EXACT_ALARM pour l'alarme exacte, Android
         12 et plus, RECEIVE_BOOT_COMPLETED pour reprogrammer au
         redémarrage. Le paquet déclare déjà POST_NOTIFICATIONS
         et VIBRATE dans son propre manifeste. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Écran d'appel natif comme WhatsApp, 20 nov. 2026 :
         l'appel entrant s'affiche en plein écran, avec la
         sonnerie du téléphone, même application fermée ou
         téléphone verrouillé (flutter_callkit_incoming).
         USE_FULL_SCREEN_INTENT pour l'écran en plein écran,
         FOREGROUND_SERVICE pour le service d'appel, et
         FOREGROUND_SERVICE_PHONE_CALL pour Android 14 et plus.
         Le paquet déclare déjà ces trois permissions dans son
         propre manifeste, elles sont répétées ici pour les
         rendre visibles dans l'application. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Réveil en arrière-plan, carte 151, 22 nov. 2026 :
         exemption d'optimisation de la batterie, pour que FCM
         réveille l'application endormie et que le sondage
         reprenne. Demandée via permission_handler, jamais
         accordée silencieusement : l'utilisateur accepte dans
         le dialogue système. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Réunions en ligne, 1er nov. 2026 : micro et caméra pour la
         visioconférence Jitsi intégrée. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Android 11 et plus : visibilité des applications pouvant ouvrir
         les liens Wave (https) et les e-mails de prière (mailto).
         L'intent PROCESS_TEXT du modèle Flutter est conservé. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
    <application
        tools:replace="android:label"
        android:label="CONNEXION PROPHETIQUE"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Carte 94, 8 nov. 2026 : receveurs de flutter_local_notifications,
             exigés par sa documentation, absents jusqu'ici, ce qui
             empêchait toute notification programmée d'être délivrée.
             ScheduledNotificationReceiver affiche la notification à
             l'heure programmée, même application fermée.
             ScheduledNotificationBootReceiver reprogramme les
             notifications en cache après un redémarrage, par le
             paquet lui-même, aucun receveur natif propre construit. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
